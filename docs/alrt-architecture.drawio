        <mxCell id="c_scheduled" value="status=scheduled&lt;br&gt;Beat poller picks up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="415" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c_wf" value="&lt;b&gt;workflow.execute&lt;/b&gt;&lt;br&gt;Queue: celery (default)&lt;br&gt;&lt;i&gt;Walks graph nodes in order&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="520" width="220" height="70" as="geometry" />
