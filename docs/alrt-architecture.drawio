        <mxCell id="t_tmpl" value="&lt;b&gt;templates (NEW)&lt;/b&gt;&#10;―――――――――――――&#10;id UUID PK&#10;team_id UUID FK → teams&#10;name VARCHAR(255)&#10;channel VARCHAR(20)&#10;subject VARCHAR(500)&#10;body TEXT&#10;variables JSONB&#10;status (draft/active)&#10;UNIQUE(team_id, name, channel)" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;rounded=1;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
