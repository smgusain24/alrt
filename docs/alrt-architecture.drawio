        <mxCell id="db_title" value="&lt;b&gt;Alrt — Database Schema&lt;/b&gt;&lt;br&gt;PostgreSQL | 12 tables | asyncpg (raw SQL, no ORM)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="600" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t_teams" value="&lt;b&gt;teams&lt;/b&gt;&#10;―――――――――――&#10;id UUID PK&#10;name VARCHAR(255)&#10;created_at TIMESTAMPTZ&#10;updated_at TIMESTAMPTZ" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;rounded=1;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="t_users" value="&lt;b&gt;users&lt;/b&gt;&#10;―――――――――――&#10;id UUID PK&#10;email VARCHAR(255) UNIQUE&#10;password_hash VARCHAR(255)&#10;team_id UUID FK → teams&#10;role VARCHAR(20)&#10;is_active BOOLEAN" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;rounded=1;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="t_apikeys" value="&lt;b&gt;api_keys&lt;/b&gt;&#10;―――――――――――&#10;id UUID PK&#10;team_id UUID FK → teams&#10;key_hash VARCHAR(64)&#10;key_type VARCHAR(10)&#10;is_active BOOLEAN" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;rounded=1;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t_subs" value="&lt;b&gt;subscribers&lt;/b&gt;&#10;―――――――――――――&#10;id UUID PK&#10;team_id UUID FK → teams&#10;external_id VARCHAR(255)&#10;email, name, slack_user_id&#10;phone_number VARCHAR(50)&#10;custom_properties JSONB&#10;channel_preferences JSONB&#10;is_deleted BOOLEAN&#10;UNIQUE(team_id, external_id)" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;rounded=1;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="220" height="190" as="geometry" />
        </mxCell>
        <mxCell id="t_wf" value="&lt;b&gt;workflows&lt;/b&gt;&#10;―――――――――――――&#10;id UUID PK&#10;team_id UUID FK → teams&#10;name, event_name&#10;category VARCHAR(50)&#10;definition JSONB&#10;status (draft/active)&#10;UNIQUE(team_id, event_name)" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;rounded=1;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="580" y="100" width="210" height="160" as="geometry" />
        </mxCell>
        <mxCell id="t_exec" value="&lt;b&gt;workflow_executions&lt;/b&gt;&#10;―――――――――――――――&#10;id UUID PK&#10;team_id FK, workflow_id FK&#10;subscriber_id UUID FK&#10;event_payload JSONB&#10;channels JSONB&#10;overrides JSONB&#10;deliver_at TIMESTAMPTZ&#10;metadata JSONB&#10;status (running/scheduled/done)&#10;idempotency_key UNIQUE" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;rounded=1;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="850" y="100" width="230" height="200" as="geometry" />
        </mxCell>
        <mxCell id="t_notif" value="&lt;b&gt;notifications&lt;/b&gt;&#10;―――――――――――――&#10;id UUID PK&#10;team_id, subscriber_id FK&#10;workflow_id, execution_id FK&#10;channel VARCHAR(20)&#10;title, body, action_url&#10;payload JSONB&#10;status (pending/sent/failed/&#10;  archived/dead_letter)&#10;error_reason TEXT&#10;retry_count INTEGER&#10;is_read, is_archived BOOLEAN&#10;sent_at TIMESTAMPTZ" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;rounded=1;spacingLeft=6;spacingTop=4;spacingRight=6;" vertex="1" parent="1">
