        <mxCell id="tf_title" value="&lt;b&gt;Template Resolution Flow (TMPL-01)&lt;/b&gt;&lt;br&gt;How templates are created, stored, and resolved at delivery time" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tf_create" value="&lt;b&gt;1. Create Template&lt;/b&gt;&lt;br&gt;POST /templates&lt;br&gt;{name, channel, subject, body, variables}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tf_db" value="&lt;b&gt;templates table&lt;/b&gt;&lt;br&gt;id, team_id, name, channel&lt;br&gt;subject, body, variables&lt;br&gt;status: draft / active" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tf_wfb" value="&lt;b&gt;2. Workflow Builder&lt;/b&gt;&lt;br&gt;Channel node references&lt;br&gt;template_id in definition JSONB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="100" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tf_trigger" value="&lt;b&gt;3. POST /events/trigger&lt;/b&gt;&lt;br&gt;event_name matches workflow, execute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="220" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tf_step" value="&lt;b&gt;4. step_runner.execute_step&lt;/b&gt;&lt;br&gt;Reads node.data.template&lt;br&gt;(may contain template_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="320" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tf_worker" value="&lt;b&gt;5. Channel Worker (deliver)&lt;/b&gt;&lt;br&gt;template_data.get('template_id')&lt;br&gt;SELECT ... FROM templates WHERE id=$1&lt;br&gt;Merge: {subject, body} from DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="430" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="tf_render" value="&lt;b&gt;6. Jinja2 Render&lt;/b&gt;&lt;br&gt;body.render(payload=..., subscriber=...)&lt;br&gt;{{ payload.order_id }} {{ subscriber.name }}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="570" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tf_deliver" value="&lt;b&gt;7. Send&lt;/b&gt;&lt;br&gt;Resend / Slack / Redis Pub/Sub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="690" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tf_fallback" value="&lt;b&gt;Fallback (no template_id)&lt;/b&gt;&lt;br&gt;Use inline subject/body&lt;br&gt;from node.data.template&lt;br&gt;&lt;i&gt;Backward compatible&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="440" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tf_preview" value="&lt;b&gt;Preview (standalone)&lt;/b&gt;&lt;br&gt;POST /templates/:id/preview&lt;br&gt;Renders without triggering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="230" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tfe1" value="" style="rounded=1;" edge="1" source="tf_create" target="tf_db" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tfe2" value="" style="rounded=1;" edge="1" source="tf_wfb" target="tf_trigger" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tfe3" value="" style="rounded=1;" edge="1" source="tf_trigger" target="tf_step" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tfe4" value="" style="rounded=1;" edge="1" source="tf_step" target="tf_worker" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tfe5" value="" style="rounded=1;" edge="1" source="tf_worker" target="tf_render" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tfe6" value="" style="rounded=1;" edge="1" source="tf_render" target="tf_deliver" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tfe7" value="no template_id" style="rounded=1;dashed=1;strokeColor=#999;fontSize=9;fontColor=#999;" edge="1" source="tf_worker" target="tf_fallback" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tfe8" value="SELECT template" style="rounded=1;fontSize=9;" edge="1" source="tf_worker" target="tf_db" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tfe9" value="" style="rounded=1;dashed=1;strokeColor=#999;" edge="1" source="tf_db" target="tf_preview" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="retention-flow" name="Data Retention Flow">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ret_title" value="&lt;b&gt;Notification Log Retention (DATA-01)&lt;/b&gt;&lt;br&gt;Archival policy for notifications older than 90 days" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ret_beat" value="&lt;b&gt;Celery Beat&lt;/b&gt;&lt;br&gt;every 24 hours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ret_task" value="&lt;b&gt;archive_old_notifications&lt;/b&gt;&lt;br&gt;tasks/retention.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="120" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ret_loop" value="&lt;b&gt;Batch Loop&lt;/b&gt;&lt;br&gt;BATCH_SIZE = 1000&lt;br&gt;Repeats until count &lt; 1000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="110" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ret_cte" value="&lt;b&gt;CTE Query&lt;/b&gt;&lt;br&gt;&lt;br&gt;WITH archived AS (&lt;br&gt;  UPDATE notifications&lt;br&gt;  SET status = 'archived'&lt;br&gt;  WHERE created_at &lt; now() - '90 days'&lt;br&gt;    AND status NOT IN&lt;br&gt;      ('archived', 'dead_letter')&lt;br&gt;  LIMIT 1000&lt;br&gt;  RETURNING id&lt;br&gt;)&lt;br&gt;SELECT COUNT(*) FROM archived" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="160" y="240" width="280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ret_idx" value="&lt;b&gt;Covering Index&lt;/b&gt;&lt;br&gt;&lt;br&gt;idx_notifications_active_window&lt;br&gt;ON notifications(subscriber_id,&lt;br&gt;  created_at DESC)&lt;br&gt;WHERE status NOT IN&lt;br&gt;  ('archived', 'dead_letter')&lt;br&gt;&lt;br&gt;Active-window queries skip&lt;br&gt;archived rows entirely" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="160" y="480" width="280" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ret_label" value="&lt;b&gt;Notification Status Machine&lt;/b&gt;" style="text;html=1;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="230" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="ret_s1" value="pending" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="270" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ret_s2" value="sent" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="270" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ret_s3" value="failed" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="350" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ret_s4" value="dead_letter" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="350" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ret_s5" value="archived" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="670" y="440" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rse1" value="" style="rounded=1;" edge="1" source="ret_s1" target="ret_s2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rse2" value="" style="rounded=1;" edge="1" source="ret_s1" target="ret_s3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rse3" value="retries exhausted" style="rounded=1;fontSize=8;" edge="1" source="ret_s3" target="ret_s4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rse4" value="90 days" style="rounded=1;fontSize=8;" edge="1" source="ret_s2" target="ret_s5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rse5" value="90 days" style="rounded=1;fontSize=8;" edge="1" source="ret_s3" target="ret_s5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re1" value="" style="rounded=1;" edge="1" source="ret_beat" target="ret_task" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re2" value="" style="rounded=1;" edge="1" source="ret_task" target="ret_loop" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re3" value="" style="rounded=1;" edge="1" source="ret_loop" target="ret_cte" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
