          <mxGeometry x="400" y="520" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c_channel_node" value="&lt;b&gt;Channel Node&lt;/b&gt;&lt;br&gt;1. Check global prefs&lt;br&gt;2. Check category prefs&lt;br&gt;3. Check DND window&lt;br&gt;4. Check frequency cap&lt;br&gt;5. Resolve template_id&lt;br&gt;6. Dispatch to channel task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="700" y="400" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="c_cond_node" value="&lt;b&gt;Condition Node&lt;/b&gt;&lt;br&gt;9 operators:&lt;br&gt;equals, not_equals, exists&lt;br&gt;greater_than, less_than, between&lt;br&gt;contains, starts_with, regex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="700" y="560" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c_delay_node" value="&lt;b&gt;Delay Node&lt;/b&gt;&lt;br&gt;scheduled_steps table&lt;br&gt;Beat polls every 30s&lt;br&gt;Preserves subscriber context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
