        <mxCell id="c_title" value="&lt;b&gt;Alrt — Celery Task Hierarchy and Worker Flow&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#1a1a2e;" vertex="1" parent="1">
