        <mxCell id="m_p3" value="&lt;b&gt;Phase 3: Platform Hardening&lt;/b&gt;&lt;br&gt;&lt;br&gt;TRIG-01 Inline subscriber upsert&lt;br&gt;TRIG-02 deliver_at scheduling&lt;br&gt;TRIG-03 metadata tagging&lt;br&gt;TRIG-04 Bulk trigger&lt;br&gt;FIX-02 Redis cleanup&lt;br&gt;FIX-03 Atomic idempotency&lt;br&gt;COND-01/02 Condition ops&lt;br&gt;WF-01 Graph validation&lt;br&gt;RETRY-01 Dead letter queue&lt;br&gt;SCALE-01 Channel queues&lt;br&gt;PREF-01 Preferences polish&lt;br&gt;TMPL-01 Template mgmt&lt;br&gt;DATA-01 Log retention&lt;br&gt;&lt;br&gt;&lt;b&gt;14/14 complete&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=15;verticalAlign=top;spacingTop=10;arcSize=8;" vertex="1" parent="1">
