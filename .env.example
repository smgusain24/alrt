# =============================================================================
# alrt — Self-Hosted Configuration
# =============================================================================
# Copy this file to .env and run ./setup.sh to auto-generate secrets.
# Then run: docker compose up
# =============================================================================

# --- Core (REQUIRED — no defaults, app won't start without these) ---
DATABASE_URL=postgresql://alrt:alrt@postgres:5432/alrt
REDIS_URL=redis://redis:6379
API_SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME

# --- Dashboard ---
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
DASHBOARD_URL=http://localhost:3000
COOKIE_SECURE=false

# --- Slack OAuth (optional — needed for Slack channel) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# --- Rate Limiting ---
RATE_LIMIT_WRITE=60/minute
RATE_LIMIT_READ=120/minute
RATE_LIMIT_PUBLIC=30/minute
